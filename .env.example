APP_NAME="Antiquariat Webshop"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.antike-stiche.de

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=antiquariat
DB_USERNAME=antiquariat_user
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_DRIVER=file
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local

# ---------------------------------------------------------------------------
# Shop-Einstellungen
# ---------------------------------------------------------------------------
SHOP_NAME="Antiquariat – Antike Stiche & Druckgrafiken"
SHOP_TAGLINE="Historische Druckgrafiken, Landkarten & Kupferstiche"
SHOP_OWNER_NAME="Ihr Name"
SHOP_CONTACT_EMAIL=info@antike-stiche.de
SHOP_CONTACT_PHONE="+49 XXX XXXXXXX"

# Bankverbindung (für Überweisung)
SHOP_BANK_IBAN="DE12 3456 7890 1234 5678 90"
SHOP_BANK_BIC="XXXXXXXX"
SHOP_BANK_NAME="Sparkasse Musterstadt"

# Versandkosten (€)
SHOP_SHIPPING_DE=3.80
SHOP_SHIPPING_EU=6.50
SHOP_SHIPPING_WORLD=12.00

# Zahlungsmethoden (true/false)
SHOP_PAYMENT_PAYPAL=true
SHOP_PAYMENT_STRIPE=true
SHOP_PAYMENT_BANK=true

# ---------------------------------------------------------------------------
# Zahlungsanbieter
# ---------------------------------------------------------------------------

# Stripe
STRIPE_KEY=pk_live_...
STRIPE_SECRET=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=false

# ---------------------------------------------------------------------------
# eBay API (Trading API)
# ---------------------------------------------------------------------------
EBAY_SYNC_ENABLED=false
EBAY_SYNC_INTERVAL=30
EBAY_APP_ID=
EBAY_DEV_ID=
EBAY_CERT_ID=
EBAY_AUTH_TOKEN=
EBAY_SANDBOX=false

# ---------------------------------------------------------------------------
# DeepL (automatische Übersetzungen)
# ---------------------------------------------------------------------------
DEEPL_ENABLED=false
DEEPL_API_KEY=

# ---------------------------------------------------------------------------
# one.com Spezifisch
# ---------------------------------------------------------------------------
# Session-Pfad manuell setzen falls nötig:
# SESSION_FILES_PATH=/path/to/sessions
